#!/bin/sh
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
export TZ=Asia/Ho_Chi_Minh
mkdir -p /var/mobile/Library/Logs
log=/var/mobile/Library/Logs/GofaHUD-install.log
stamp() { date '+%Y-%m-%dT%H:%M:%S%z'; }
printf '%s script=%s action=%s version=0.3.1-1 begin\n' "$(stamp)" "$0" "${1:-}" >> "$log"
trap 'result=$?; printf "%s script=%s exit=%s\n" "$(stamp)" "$0" "$result" >> "$log"' EXIT
[ "${1:-}" = configure ] || exit 0
for label in native-speed drive-recorder diagnostics; do
 launchctl bootout "system/local.gofahud.$label" >/dev/null 2>&1 || true
done
for label in native-speed drive-recorder diagnostics; do
 launchctl bootstrap system "/Library/LaunchDaemons/local.gofahud.$label.plist" >> "$log" 2>&1 || exit 1
done
echo 'GOFA HUD iOS 14 Rootful installed. Respring, open GOFA 4.2.1, then return Home.' | tee -a "$log"
exit 0
