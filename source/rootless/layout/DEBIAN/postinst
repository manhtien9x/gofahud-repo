#!/var/jb/bin/sh
set -eu
export PATH=/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin
[ "${1:-}" = configure ] || exit 0
for file in \
    /var/jb/Library/MobileSubstrate/DynamicLibraries/GOFADevProbe.dylib \
    /var/jb/Library/MobileSubstrate/DynamicLibraries/GofaLifecycle.dylib \
    /var/jb/Library/MobileSubstrate/DynamicLibraries/GofaLaunchHelper.dylib \
    /var/jb/Library/MobileSubstrate/DynamicLibraries/GofaPhoneOverlay.dylib \
    /var/jb/Library/MobileSubstrate/DynamicLibraries/GofaCarplayGlobal.dylib \
    /var/jb/Library/MobileSubstrate/DynamicLibraries/GofaCarplayOverlay.dylib \
    /var/jb/usr/libexec/gofahud-tests/gofahud-native-speed-bridge \
    /var/jb/usr/libexec/gofahud-tests/gofahud-test-speed
do
    digest=$(/var/jb/usr/bin/ldid -h "$file" | sed -n 's/^CDHash=//p')
    case "$digest" in ''|*[!0-9a-f]*) echo "Invalid code signature: $file" >&2; exit 1;; esac
    [ "${#digest}" -eq 40 ] || exit 1
    /var/jb/usr/bin/jbctl trustcache add "$digest"
done
for label in native-speed drive-recorder; do
    launchctl bootout "system/local.gofahud.$label" >/dev/null 2>&1 || true
    launchctl bootstrap system "/var/jb/Library/LaunchDaemons/local.gofahud.$label.plist"
done
echo 'GOFA HUD installed. Respring to load the bubbles, then reopen GOFA.'
exit 0
